#!/bin/bash
set -euo pipefail

# Use bash parameter expansion instead of the `dirname` binary to avoid
# glibc version mismatches when running inside a container.
_script_src="${BASH_SOURCE[0]}"
case "$_script_src" in
  */*) SCRIPT_DIR="$(cd "${_script_src%/*}" && pwd)" ;;
  *)   SCRIPT_DIR="$PWD" ;;
esac
VENV_DIR="$SCRIPT_DIR/.venv"

python3 "$SCRIPT_DIR/bootstrap.py"

if [ -x "$VENV_DIR/bin/python" ]; then
  VENV_PY="$VENV_DIR/bin/python"
elif [ -x "$VENV_DIR/Scripts/python.exe" ]; then
  VENV_PY="$VENV_DIR/Scripts/python.exe"
else
  echo "Virtualenv python not found under $VENV_DIR" >&2
  exit 1
fi

export PYTHONPATH="$SCRIPT_DIR/implementation/python"

# The engine requires a free-threaded (no-GIL) interpreter. SimpleITK and numba
# both re-enable the GIL at import unless PYTHON_GIL=0 overrides them, and that
# variable is read at interpreter startup -- so it MUST be exported here, before
# exec; setting it from Python is too late. Detected, not hardcoded, so a venv
# rebuilt onto a GIL build fails loudly instead of silently running serialized.
# See doc/dev/gil-free-default-plan.md.
if "$VENV_PY" -c 'import sysconfig,sys; sys.exit(0 if sysconfig.get_config_var("Py_GIL_DISABLED") else 1)'; then
  export PYTHON_GIL=0
else
  echo "ERROR: $VENV_PY is not a free-threaded build." >&2
  echo "  VoxLogicA requires free-threaded CPython (cp314t); see doc/dev/gil-free-default-plan.md." >&2
  echo "  Remove .venv and re-run to let bootstrap.py rebuild it from .python-version." >&2
  exit 1
fi

exec "$VENV_PY" -m voxlogica.main "$@"
