// VoxLogicA experimental compatibility library.
//
// This module is auto-exported when importing namespace "vox1".
// It maps dot-based operators and derived helpers to Python kernels.

let ./.(a,b) = num_div(a,b)
let .*.(a,b) = num_mul(a,b)
let .+.(a,b) = num_add(a,b)
let .-.(a,b) = num_sub(a,b)
let .&.(a,b) = bool_and_scalar(a,b)
let .|.(a,b) = bool_or_scalar(a,b)
let !.(a) = bool_not_scalar(a)
let .=.(a,b) = num_eq(a,b)
let .<=.(a,b) = num_leq(a,b)
let .<.(a,b) = num_lt(a,b)
let .>=.(a,b) = num_geq(a,b)
let .>.(a,b) = num_gt(a,b)

let .= (n,i) = eq_sv(n,i)
let .<= (n,i) = geq_sv(n,i)
let .>= (n,i) = leq_sv(n,i)
let ./ (n,i) = n / i
let .- (n,i) = n - i
let /. (i,n) = i / n
let -. (i,n) = i - n
let +. (i,n) = i + n
let *. (i,n) = i * n

let &(a,b) = and(a,b)
let |(a,b) = or(a,b)
let !(a) = not(a)
let ~>(a,b) = through(b,a)
let N(a) = near(a)
let I(a) = interior(a)
let B+(a) = (near(a)) \ a

let \(a,b) = and(a,not(b))

let mayReach(a,b) = N((b ~> N(a)) | a)
let touch(a,b) = a ~> N(b)
let grow(a,b) = (a | touch(b,a))
let T(a,b) = touch(a,b)

let surrounded(a,b) = a \ mayReach(not(a | b),not(b))
let S(a,b) = surrounded(a,b)

let .< (n,i) = (n .<= i) & (!(n .= i))
let .> (n,i) = (n .>= i) & (!(n .= i))
let <. (i,n) = n .> i
let <=. (i,n) = n .>= i
let >. (i,n) = n .< i
let >=. (i,n) = n .<= i
let =. (i,n) = n .= i

let .* (a,b) = a * b
let .+ (a,b) = a + b

let pdt(x) = mask(dt(x),dt(x) >. 0)
// SQUARED, on both sides. `pdt2` is the squared positive distance and the
// radius is squared to match: equivalent because both sides are non-negative
// and squaring is monotone there, and it drops one square root per voxel from
// the operator that is 54% of a threshold sweep's kernel time. `pdt` itself is
// left alone -- it is a distance and a program may want it as one.
//
// A NEGATIVE radius would flip the comparison, and is not a case these mean
// anything for: a radius is a length.
let pdt2(x) = mask(dt2(x),dt2(x) >. 0)
let distgeq(x,y) = (x .* x) .<= pdt2(y)
let distleq(x,y) = (x .* x) .>= pdt2(y)
// NOT ball_opening, and the measurement says why. One ITK binary opening by a
// ball replaces the two distance transforms and runs the 20-case sweep in
// 16.4 s against 27.1 s -- 42% off the wall clock, half the kernels -- but it
// is a DIFFERENT opening, not a faster one: the discrete ball of radius r
// implies `d > r` while this formulation asks `d >= r`, so the ball erodes one
// shell further. Measured on one case at radius 2: 137,543 voxels against
// 158,646, a difference of 21,103. The sweep's Dice moves 0.8514 -> 0.8612.
//
// That is a change of method and belongs to whoever owns the experiment, not
// to a performance pass: it would move every published number, and 0.0098 on
// twenty cases is inside the noise this project has agreed not to treat as a
// result. `ball_opening` stays available for anyone who wants that convention
// deliberately. doc/dev/measurements/2026-09-09-ball-opening/ has both.
let smoothen(a,x) = distleq(x,distgeq(x,!(a)))

let ~ (a,b,rad,bins) = crossCorrelation(rad,a,b,tt,min(b),max(b),bins)

let booleanToNumber(k,x) = mask(constant(k),x)
let norm(k,x) = (k .* x) /. max(x)

let ifB(cond,th,el) = or(and(th,bconstant(cond)),and(el,not(bconstant(cond))))
let ifN(cond,th,el) = mask(th,bconstant(cond)) + mask(el,not(bconstant(cond)))

let maskCC(phi1,phi2) = mask(Lcc(phi2),phi1)
let minCC(phi1,phi2) = min(maskCC(phi1,phi2))
let maxCC(phi1,phi2) = max(maskCC(phi1,phi2))

let collect(phi1,phi2) = (vol(phi1) .=. 0) | ((minCC(phi1,phi2) .=. maxCC(phi1,phi2)) & (maxCC(phi1,phi2) .>. 0))

let emptyB(phi) = volume(phi) .=. 0
let nemptyB(phi) = volume(phi) .>. 0

let xor(phi1,phi2) = (phi1 & !(phi2)) | (phi2 & !(phi1))
let eqB(phi1,phi2) = emptyB(xor(phi1,phi2))
let neqB(phi1,phi2) = nemptyB(xor(phi1,phi2))
let leqB(phi1,phi2) = emptyB(phi1 & !(phi2))

let overlayB(boolean,maskfalse,masktrue) = mask(masktrue,boolean) + mask(maskfalse,!(boolean))
let overlayColor(boolean,img,r,g,b) = rgb(overlayB(boolean,red(img),constant(r)),overlayB(boolean,green(img),constant(g)),overlayB(boolean,blue(img),constant(b)))

let divZ(i1,i2,i3) = mask((i1 / mask(constant(1),!(i2 =. 0))),!(i2 =. 0)) + (mask(i3,i2 =. 0))

let erode(a,x) = !(distleq(x,!(a)))
let dilate(a,x) = distleq(x,a)
let imopen(a,x) = dilate(erode(a,x),x)
let imclose(a,x) = erode(dilate(a,x),x)
