import "stdlib.imgql"

let dice(x,y) = (2 .*. volume(x & y)) ./. (volume(x) .+. volume(y))
let distlt(x,y) = dt(y) <. x
let grow2(a,b) = (a|touch(b,a))
let flt(r,a) = distlt(r,distgeq(r,!a))

// === case 1 ===
load imgFLAIR1 = "/home/VoxLogicA/datasets/MICCAI_BraTS2020_TrainingData/BraTS20_Training_001/BraTS20_Training_001_flair.nii.gz"
let flair1 = intensity(imgFLAIR1)
load imgSeg1 = "/home/VoxLogicA/datasets/MICCAI_BraTS2020_TrainingData/BraTS20_Training_001/BraTS20_Training_001_seg.nii.gz"
let gt1 = intensity(imgSeg1) >. 0
let background1 = touch(flair1 <. 0.1, border)
let pflair1 = percentiles(flair1, !background1, 0.5)
let seg1 = grow2(flt(5.0, pflair1 >. 0.95), flt(2.0, pflair1 >. 0.86))
print "dice_c1" dice(seg1, gt1)

