// Generated by generate_programs.py -- edit that, not this.
//
// VoxLogicA 1's own constants and VoxLogicA 1's own `flt`, so the comparison is
// between engines rather than between two different smoothings: `smoothen` here
// instead cost 0.02 to 0.03 Dice per case and looked, for a while, like an
// engine divergence.
import "simpleitk"
import "vox1"

dataset_root = "/home/VoxLogicA/datasets/MICCAI_BraTS2020_TrainingData"

flair_paths = subsequence(dir(dataset_root, "*_flair.nii.gz", true, true), 0, 20)
gt_paths    = subsequence(dir(dataset_root, "*_seg.nii.gz",   true, true), 0, 20)

distlt(x, y) = dt(y) <. x
flt(r, a) = distlt(r, distgeq(r, not(a)))
dice(x, y) = (2 * volume(and(x, y))) / (volume(x) + volume(y))

flair_of(g) = intensity(ReadImage(index(flair_paths, g)))
gt_of(g)    = geq_sv(1, intensity(ReadImage(index(gt_paths, g))))

pflair_of(g) =
  let flair = flair_of(g) in
  percentiles(flair, not(touch(leq_sv(0.1, flair), border(flair))), 0.5)

segment(g) =
  let pflair = pflair_of(g) in
  grow(flt(5.0, geq_sv(0.95, pflair)), flt(2.0, geq_sv(0.86, pflair)))

print "dice_c1" dice(segment(0), gt_of(0))
print "dice_c2" dice(segment(1), gt_of(1))
print "dice_c3" dice(segment(2), gt_of(2))
print "dice_c4" dice(segment(3), gt_of(3))
print "dice_c5" dice(segment(4), gt_of(4))
print "dice_c6" dice(segment(5), gt_of(5))
print "dice_c7" dice(segment(6), gt_of(6))
print "dice_c8" dice(segment(7), gt_of(7))
print "dice_c9" dice(segment(8), gt_of(8))
print "dice_c10" dice(segment(9), gt_of(9))
print "dice_c11" dice(segment(10), gt_of(10))
print "dice_c12" dice(segment(11), gt_of(11))
print "dice_c13" dice(segment(12), gt_of(12))
print "dice_c14" dice(segment(13), gt_of(13))
print "dice_c15" dice(segment(14), gt_of(14))
print "dice_c16" dice(segment(15), gt_of(15))
print "dice_c17" dice(segment(16), gt_of(16))
print "dice_c18" dice(segment(17), gt_of(17))
print "dice_c19" dice(segment(18), gt_of(18))
print "dice_c20" dice(segment(19), gt_of(19))
