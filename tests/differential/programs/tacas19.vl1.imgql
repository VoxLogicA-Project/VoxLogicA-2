import "stdlib.imgql"

let dice(x,y) = (2 .*. volume(x & y)) ./. (volume(x) .+. volume(y))
let distlt(x,y) = dt(y) <. x
let grow2(a,b) = (a|touch(b,a))
let flt(r,a) = distlt(r,distgeq(r,!a))


// === case 1: BraTS20_Training_001 ===
load imgFLAIRc1 = "/home/VoxLogicA/datasets/MICCAI_BraTS2020_TrainingData/BraTS20_Training_001/BraTS20_Training_001_flair.nii.gz"
let flairc1 = intensity(imgFLAIRc1)
load imgManualSegc1 = "/home/VoxLogicA/datasets/MICCAI_BraTS2020_TrainingData/BraTS20_Training_001/BraTS20_Training_001_seg.nii.gz"
let manualContouringGTVc1 = intensity(imgManualSegc1) >. 0
let diceMc1(x) = dice(x,manualContouringGTVc1)

let backgroundc1 = touch(flairc1 <. 0.1,border)
let brainc1 = !backgroundc1
let pflairc1 = percentiles(flairc1,brainc1,0.5)

let hIc1 = pflairc1 >. 0.95
let vIc1 = pflairc1 >. 0.86
let hyperIntensec1 = flt(5.0,hIc1)
let veryIntensec1 =  flt(2.0,vIc1)

let growTumc1 = grow2(hyperIntensec1,veryIntensec1)

print "dice_c1" diceMc1(growTumc1)

