import "stdlib.imgql"

let dice(x,y) = (2 .*. volume(x & y)) ./. (volume(x) .+. volume(y))
let erodeL(a,x) = !(distleq(x,!a))
let dilateL(a,x) = distleq(x,a)
let imopenL(a,x) = dilateL(erodeL(a,x),x)
let imcloseL(a,x) = erodeL(dilateL(a,x),x)
let boundaryL(a) = (N(a)) \ a

load imgFLAIR = "/home/VoxLogicA/datasets/MICCAI_BraTS2020_TrainingData/BraTS20_Training_001/BraTS20_Training_001_flair.nii.gz"
let flair = intensity(imgFLAIR)
load imgSeg = "/home/VoxLogicA/datasets/MICCAI_BraTS2020_TrainingData/BraTS20_Training_001/BraTS20_Training_001_seg.nii.gz"
let gt = intensity(imgSeg) >. 0

let background = touch(flair <. 0.1, border)
let brain = !background
let pflair = percentiles(flair, brain, 0.5)
let hi = pflair >. 0.95
let vi = pflair >. 0.86

print "vol_brain" volume(brain)
print "vol_hi" volume(hi)
print "vol_vi" volume(vi)
print "vol_not" volume(!hi)
print "vol_and" volume(hi & vi)
print "vol_or" volume(hi | vi)
print "vol_setminus" volume(vi \ hi)
print "vol_xor" volume(xor(hi, vi))
print "vol_near" volume(N(hi))
print "vol_interior" volume(I(hi))
print "vol_boundary" volume(boundaryL(hi))
print "vol_touch" volume(touch(vi, hi))
print "vol_grow" volume(grow(hi, vi))
print "vol_surrounded" volume(surrounded(hi, brain))
print "vol_mayreach" volume(mayReach(hi, vi))
print "vol_distleq" volume(distleq(2.0, hi))
print "vol_distgeq" volume(distgeq(2.0, hi))
print "vol_smoothen" volume(smoothen(hi, 2.0))
print "vol_erode" volume(erodeL(hi, 2.0))
print "vol_dilate" volume(dilateL(hi, 2.0))
print "vol_imopen" volume(imopenL(hi, 2.0))
print "vol_imclose" volume(imcloseL(hi, 2.0))
print "max_flair" max(flair)
print "min_flair" min(flair)
print "max_pflair" max(pflair)
print "dice_hi" dice(hi, gt)
print "dice_grow" dice(grow(hi, vi), gt)
